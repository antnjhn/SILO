{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SILO",
  "version": "0.2.3",
  "identifier": "com.silo.launcher",
  "build": {
    "frontendDist": "../src/renderer",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "SILO",
        "width": 1280,
        "height": 720,
        "resizable": true,
        "maximized": true,
        "fullscreen": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' ipc: http://ipc.localhost asset: http://asset.localhost; img-src 'self' asset: http://asset.localhost data: blob: https://*.steamstatic.com https://*.steampowered.com https://*.steamgriddb.com;",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**", "$APPCONFIG/**", "$APPDATA/com.tauri.dev/**", "$HOME/.local/share/**", "$HOME/.config/**", "$HOME/.var/**"]
      }
    },
    "withGlobalTauri": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/antnjhn/SILO/releases/latest/download/latest.json"
      ],
      "pubkey": "Pppk4hZp7jOIxjkj9IclIEHm0nVpb0qw3Xr1C1hYw3w="
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libayatana-appindicator3-1", "librsvg2-2", "libssl3", "libglib2.0-0", "libgtk-3-0", "libxdo3", "libsoup-3.0-0", "libjavascriptcoregtk-4.1-0"]
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
